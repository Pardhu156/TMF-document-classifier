# =========================
# DagsHub / MLflow Config
# =========================
DAGSHUB_USERNAME=your_dagshub_username
DAGSHUB_REPO_NAME=your_dagshub_repo_name

MLFLOW_TRACKING_URI=https://dagshub.com/your_dagshub_username/your_dagshub_repo_name.mlflow
MLFLOW_TRACKING_USERNAME=your_dagshub_username
# Use a DagsHub access token here, never your DagsHub account password.
MLFLOW_TRACKING_PASSWORD=your_dagshub_access_token

MLFLOW_EXPERIMENT_NAME=tmf_classifier_experiments

# =========================
# DVC Config
# =========================
DVC_REMOTE_NAME=origin
DVC_REMOTE_URL=https://dagshub.com/your_dagshub_username/your_dagshub_repo_name.dvc

# =========================
# Project Config
# =========================
PROJECT_NAME=TMF_Classifier
MODEL_VERSION=v1.0.0
DATASET_VERSION=v1.0.0
ENVIRONMENT=local

# =========================
# AWS S3 Config
# =========================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=tmf-classifier-stage4-bucket

# =========================
# PostgreSQL Config
# =========================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tmf_classifier
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

# =========================
# Stage 4 Pipeline Config
# =========================
ALLOW_DUPLICATE_DOCUMENTS=False
RETRAIN_MIN_NEW_DOCUMENTS=1
RETRAIN_ONLY_VERIFIED_DATA=True

# Copy this file to .env and fill in real values manually.
# Real .env files must never be committed.
