# =========================
# DagsHub / MLflow Config
# =========================
DAGSHUB_USERNAME=your_dagshub_username
DAGSHUB_REPO_NAME=your_dagshub_repo_name

MLFLOW_TRACKING_URI=https://dagshub.com/your_dagshub_username/your_dagshub_repo_name.mlflow
MLFLOW_TRACKING_USERNAME=your_dagshub_username
# Use a DagsHub access token here, never your DagsHub account password.
MLFLOW_TRACKING_PASSWORD=your_dagshub_access_token

MLFLOW_EXPERIMENT_NAME=tmf_classifier_experiments

# =========================
# DVC Config
# =========================
DVC_REMOTE_NAME=origin
DVC_REMOTE_URL=https://dagshub.com/your_dagshub_username/your_dagshub_repo_name.dvc

# =========================
# Project Config
# =========================
PROJECT_NAME=TMF_Classifier
MODEL_VERSION=v1.0.0
DATASET_VERSION=v1.0.0
ENVIRONMENT=local

# =========================
# Stage 7.1 Auth + RBAC Config
# =========================
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# =========================
# AWS S3 Config
# =========================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name
LOCAL_CLOUD_ROOT=agentic_tmf_workspace

# =========================
# PostgreSQL Config
# =========================
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=tmf_classifier
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# Docker Compose exposes PostgreSQL/Redis on these local host ports.
# Inside Docker, docker-compose.yml overrides POSTGRES_HOST=postgres and REDIS_URL=redis://redis:6379/0.
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6379
APP_HOST_PORT=8000

# =========================
# Stage 4 Pipeline Config
# =========================
ALLOW_DUPLICATE_DOCUMENTS=False
RETRAIN_MIN_NEW_DOCUMENTS=1
RETRAIN_ONLY_VERIFIED_DATA=True

# =========================
# RAG + Redis Config
# =========================
MASTER_DATA_DIR=MASTER_DATA
AUTO_INDEX_MASTER_DATA=False
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_GENERATION_MODEL=models/gemini-flash-lite-latest
RAG_EMBEDDING_DIMENSION=768
RAG_SEMANTIC_TOP_K=10
RAG_KEYWORD_TOP_K=10
RAG_FINAL_TOP_K=5
RAG_RERANKER_ENABLED=False
SEMANTIC_CACHE_ENABLED=True
SEMANTIC_CACHE_THRESHOLD=0.75
SEMANTIC_CACHE_TTL_SECONDS=86400
REDIS_URL=redis://localhost:6379/0

# Copy this file to .env and fill in real values manually.
# Real .env files must never be committed.

EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=NeuML/pubmedbert-base-embeddings
LOCAL_MODEL_DIR=/models/pubmedbert-base-embeddings
MODEL_BACKUP_S3_PREFIX=rag-artifacts/embedding-models/pubmedbert/
RAG_ARTIFACTS_S3_PREFIX=rag-artifacts/
RAG_INGESTION_REPORTS_S3_PREFIX=rag-artifacts/ingestion-reports/
RAG_EVALUATION_S3_PREFIX=rag-artifacts/rag-evaluation/
RAG_FAILED_INGESTIONS_S3_PREFIX=rag-artifacts/failed-ingestions/

LOCAL_EMBEDDING_DEVICE=cpu
LOCAL_EMBEDDING_BATCH_SIZE=8

# =========================
# Stage 6 Agentic Filing Config
# =========================
AUTO_APPROVAL_THRESHOLD=0.90
MIN_CONFIDENCE_GAP=0.10
MANUAL_REVIEW_QUEUE_NAME=manual_review:pending
