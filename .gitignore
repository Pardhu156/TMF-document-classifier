.env
.env.example
venv/
logs/
__pycache__/
**pycache**/
*.pyc
.ipynb_checkpoints/
.DS_Store

# DVC cache
.dvc/cache

# Generated artifacts are stored through DVC; Git stores only their .dvc pointers.
artifacts/*.csv
artifacts/*.json
artifacts/*.pkl
artifacts/*.bin
artifacts/*.safetensors
artifacts/*/

# Raw data is private; DVC stores its pointer files in Git.
data/*
!data/.gitignore
/data
